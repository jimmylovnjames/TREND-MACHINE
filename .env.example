# ─────────────────────────────────────────────────────────────────────────────
# TREND MACHINE — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Nothing here is exposed to the browser: there are no NEXT_PUBLIC_* variables,
# and every secret below is read only by server code (`server-only` enforced).
# ─────────────────────────────────────────────────────────────────────────────

# Core ------------------------------------------------------------------------
# >= 32 random chars. Signs media URLs, device ids, webhook + admin tokens.
# Required in production. Generate: openssl rand -base64 48
APP_SECRET=
# Public HTTPS origin, e.g. https://trendmachine.app. Enables provider webhooks.
PUBLIC_BASE_URL=
# Set true ONLY behind a proxy/CDN that overwrites X-Forwarded-For (Vercel, Fly, nginx).
TRUST_PROXY_HEADERS=false

# Database ----------------------------------------------------------------------
# Postgres >= 13 (Supabase, Neon, RDS, local). Empty = embedded PGlite in .data/pglite
# (development only; production refuses to start without DATABASE_URL unless
# ALLOW_PGLITE_IN_PRODUCTION=true).
DATABASE_URL=
DATABASE_SSL=false
PGLITE_DATA_DIR=.data/pglite
ALLOW_PGLITE_IN_PRODUCTION=false

# Storage (private) -------------------------------------------------------------
# local = private files on disk served via short-lived HMAC-signed URLs (single server)
# s3    = any S3-compatible PRIVATE bucket (AWS S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Generation providers ----------------------------------------------------------
# Higgsfield (Kling Motion Control). Create at https://console.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai
# Viggle V1 (fallback). Create at https://portal.viggle.ai
VIGGLE_API_KEY=
VIGGLE_API_BASE=https://apis.viggle.ai
# standard | pro — which model tier the router prefers
GENERATION_QUALITY_TIER=standard
# Per-request HTTP timeout to providers (ms)
PROVIDER_REQUEST_TIMEOUT_MS=30000

# Cost controls -----------------------------------------------------------------
# Kill switch: false pauses all new generations immediately.
GENERATION_ENABLED=true
GEN_LIMIT_PER_DEVICE_HOUR=4
GEN_LIMIT_PER_DEVICE_DAY=12
GEN_LIMIT_PER_IP_DAY=30
GEN_LIMIT_GLOBAL_DAY=200
MAX_ACTIVE_JOBS_PER_DEVICE=2
# Keep <= your provider account's concurrency limit (Higgsfield returns 400 when exceeded).
MAX_ACTIVE_JOBS_GLOBAL=4
# Optional hard stop on the sum of recorded job cost estimates in the last 24h (USD).
DAILY_BUDGET_USD=
UPLOAD_LIMIT_PER_DEVICE_HOUR=30
MAX_UPLOAD_BYTES=10485760
MAX_RESULT_BYTES=209715200

# Retention ---------------------------------------------------------------------
SOURCE_RETENTION_HOURS=24
RESULT_RETENTION_DAYS=30

# Operations --------------------------------------------------------------------
# >= 32 chars. Enables /admin. Empty = admin area fully disabled.
ADMIN_TOKEN=
# >= 24 chars. Bearer for /api/cron/tick (advance jobs + retention). Empty = endpoint disabled.
CRON_SECRET=
# >= 24 chars. Bearer for POST /api/admin/trends/ingest (external trend scanner). Empty = disabled.
TREND_INGEST_TOKEN=
